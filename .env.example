# Admin WhatsApp (receives reservation notifications)
ADMIN_WHATSAPP=+573XXXXXXXXX

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_STAFF_CHAT_ID=your-staff-group-chat-id
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# App
NEXT_PUBLIC_APP_URL=https://bethelbellinibeachclub.com
NODE_ENV=development
